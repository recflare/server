worker_processes auto;
worker_cpu_affinity auto;
pid /tmp/nginx.pid;
error_log /dev/stderr;
include /etc/nginx/modules-enabled/*.conf;

events {
  worker_connections 768;
}

http {
  sendfile on;
  tcp_nopush on;
  types_hash_max_size 2048;
  server_tokens off;
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  access_log /dev/stdout;
  gzip on;
  client_body_temp_path /tmp/nginx_client_body;
  proxy_temp_path /tmp/nginx_proxy;
  fastcgi_temp_path /tmp/nginx_fastcgi;
  uwsgi_temp_path /tmp/nginx_uwsgi;
  scgi_temp_path /tmp/nginx_scgi;

  server {
    listen $RECFALRE_PORT ssl;
    server_name $RECFALRE_DOMAIN; 
    ssl_certificate "$RECFALRE_SSL_CRT";
    ssl_certificate_key "$RECFALRE_SSL_KEY";

    location = / {
      # Dynamically rewrite ns response into format dev server expects (sub.domain -> domain/sub)
      sub_filter '.$RECFALRE_DOMAIN' '';
      sub_filter '://' '://$RECFALRE_DOMAIN:$RECFALRE_PORT/';
      sub_filter_types *;
      sub_filter_once off;
      proxy_pass http://127.0.0.1:$RECFLARE_MONO_APP_PORT; # mono 
      proxy_no_cache 1;
      proxy_cache_bypass 1; 
      proxy_set_header Accept-Encoding "";
      proxy_set_header Connection $http_connection;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /img/ {
      proxy_pass http://127.0.0.1:$RECFLARE_IMG_APP_PORT/; # img
      proxy_no_cache 1;
      proxy_cache_bypass 1; 
      proxy_set_header Connection $http_connection;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /econ/ {
      proxy_pass http://127.0.0.1:$RECFLARE_ECON_APP_PORT/; # econ
      proxy_no_cache 1;
      proxy_cache_bypass 1; 
      proxy_set_header Connection $http_connection;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
      proxy_pass http://127.0.0.1:$RECFLARE_MONO_APP_PORT; # mono
      proxy_no_cache 1;
      proxy_cache_bypass 1; 
      proxy_set_header Connection $http_connection;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}
