{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "storage",
	"main": "src/storage.app.ts",
	"compatibility_date": "2026-06-16",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [],
	// Shared CDN R2 bucket (owned by the `cdn` worker). Uploads land here under a
	// per-FileType subfolder; the `cdn` worker serves them back.
	"r2_buckets": [
		{
			"binding": "CDN_ASSETS",
			"bucket_name": "recflare-cdn"
		}
	],
	// Shared Secrets Store holding the HS256 JWT signing key. Every worker binds the
	// same store as JWT_SECRET so tokens signed by `auth` verify here. The "local"
	// store_id placeholder is replaced with RECFLARE_SECRETS_STORE at deploy time.
	"secrets_store_secrets": [
		{
			"binding": "JWT_SECRET",
			"store_id": "local",
			"secret_name": "JWT_SECRET"
		},
		// The R2 API token that signs the developer video upload (src/video-upload.ts): create one
		// in the dashboard (R2 → Manage API tokens, Object Read & Write on recflare-cdn), then
		//
		//   wrangler secrets-store secret create <store-id> --name R2_ACCESS_KEY_ID \
		//     --scopes workers --remote
		//   wrangler secrets-store secret create <store-id> --name R2_SECRET_ACCESS_KEY \
		//     --scopes workers --remote
		//
		// plus RECFLARE_R2_ACCOUNT_ID in `.env`, and a CORS rule on the bucket allowing PUT from
		// the www origin (the browser uploads to R2 directly; the exact rule is in README.md). The bindings have to resolve for the
		// deploy: an operator who wants no video uploads creates both with any placeholder value,
		// and `POST /upload/video` answers 503.
		{
			"binding": "R2_ACCESS_KEY_ID",
			"store_id": "local",
			"secret_name": "R2_ACCESS_KEY_ID"
		},
		{
			"binding": "R2_SECRET_ACCESS_KEY",
			"store_id": "local",
			"secret_name": "R2_SECRET_ACCESS_KEY"
		}
	],
	"upload_source_maps": true,
	"observability": {
		"enabled": false
	},
	"vars": {
		"ENVIRONMENT": "development", // overridden during deployment
		"SENTRY_RELEASE": "unknown" // overridden during deployment
	}
}
