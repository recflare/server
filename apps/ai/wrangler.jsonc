{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai",
	"main": "src/ai.app.ts",
	"compatibility_date": "2026-06-16",
	"compatibility_flags": ["nodejs_compat"],
	// Shared `recflare` D1 database. This worker owns the `roomie_api_key` table (each
	// player's sealed OpenAI key for Roomie); a dedicated migrations_table keeps its history
	// separate from the other workers' migrations on the same database. The "local"
	// placeholder is replaced with the real id from RECFLARE_D1 (see .env) at deploy time.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "recflare",
			"database_id": "local",
			"migrations_dir": "migrations",
			"migrations_table": "d1_migrations_ai"
		}
	],
	// Shared Secrets Store holding the HS256 JWT signing key. Every worker binds the
	// same store as JWT_SECRET so tokens signed by `auth` verify here. The "local"
	// store_id placeholder is replaced with RECFLARE_SECRETS_STORE at deploy time.
	//
	// ROOMIE_KEY_ENCRYPTION_KEY seals the players' Roomie API keys, bound only by this
	// worker so no other can open one. It must EXIST in the store or the deploy fails; see
	// DEPLOYING.md for its format and for rotating it.
	"secrets_store_secrets": [
		{
			"binding": "JWT_SECRET",
			"store_id": "local",
			"secret_name": "JWT_SECRET"
		},
		{
			"binding": "ROOMIE_KEY_ENCRYPTION_KEY",
			"store_id": "local",
			"secret_name": "ROOMIE_KEY_ENCRYPTION_KEY"
		}
	],
	"upload_source_maps": true,
	"observability": {
		"enabled": false
	},
	"vars": {
		"ENVIRONMENT": "development", // overridden during deployment
		"SENTRY_RELEASE": "unknown" // overridden during deployment
	}
}
